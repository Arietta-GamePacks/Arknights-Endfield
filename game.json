{
  // Game pack: everything Arietta needs to show and start Arknights: Endfield.
  // Lives outside the source tree (under <data>/games), so the repo stays game-agnostic.
  // Pack id doubles as the fallback title when the current UI language has no "names" entry.
  "id": "arknights-endfield",

  // Localized titles. No default language: a missing tag shows the id above.
  "names": {
    "zh-Hans": "明日方舟：终末地",
    "zh-Hant": "明日方舟：終末地",
    "en": "Arknights: Endfield",
    "ja": "アークナイツ：エンドフィールド",
    "ko": "명일방주: 엔드필드"
  },

  "vendor": "PaperKito",
  "version": "1.0.1",
  "order": 100,
  "icon": "icon.png",
  // 单服回落值：不认识 servers 的旧宿主仍把它当成国服单服包。
  "serverCode": "CN",

  // 服务器变体：宿主把一份 manifest 展开成多个可切换条目，共用封面 / provider / 设置页，
  // 但各自保存 exe 路径（PackExePath_<变体id>）与切换器选中状态。
  // 顺序对齐鸣潮：国际服 → 国服 → B服；CN 标 primary 保留原 id，
  // 已有的 PackExePath_arknights-endfield 配置不会丢。
  // 短名复用宿主码表（GL→国际服 / CN→国服 / BILI→B服），不在包里重复维护翻译。
  // markerDirs 覆盖只用于自动查找时区分安装目录，实际目录名待按各服客户端实测校正。
  "servers": [
    {
      "code": "GL",
      "id": "global",
      "markerDirs": [ "Arknights Endfield Global", "Endfield Global" ]
    },
    {
      "code": "CN",
      "primary": true
    },
    {
      "code": "BILI",
      "id": "bilibili",
      "serverIcon": "assets/launcher/endfield/server-bilibili.png",
      "markerDirs": [ "Arknights Endfield bilibili", "Endfield bilibili" ]
    }
  ],

  "exeNames": [ "Endfield.exe" ],
  "markerDirs": [ "Arknights Endfield" ],

  "launch": {
    "exe": "Endfield.exe",
    "args": "",
    // Endfield.exe is requireAdministrator and checks that its immediate parent is a
    // PaperKito-signed Games.exe. PlatformProcess.exe ships next to it, is asInvoker and
    // signed by the same certificate, so it can be staged as the suspended decoy parent.
    "decoyParent": "PlatformProcess.exe",
    "requireAdmin": true
  },

  "capabilities": {
    "launch": true,
    "gacha": true,
    "settings": true,
    "update": false,
    "accounts": false
  },

  // Artwork shipped by the pack (paths relative to the pack folder; source: official
  // GRYPHLINK launcher, see docs/资源-GRYPHLINK启动器封面与壁纸提取-交接.md).
  "assets": {
    // 主页缺省背景：用户没选背景也没拖图时铺这张（2324×1392 主视觉）。
    "background": "assets/launcher/endfield/background.webp",
    // 主题强调色：宿主直接拿它给按钮 / 开关等 Accent 控件上色，不再从背景图投票取色。
    // 这张主视觉白灰底 + 角色蓝灰占面积大，色相投票会算出蓝色（#477AB2）而不是品牌黄。
    "accentColor": "#E6D800",
    // 游戏切换器全屏卡片图：endfield_icons-main 的本地化字标 SVG 栅格化后反色成
    // 白字，合成到黑底 960×540（字标统一占卡宽 84% 居中，与鸣潮/战双「纯黑底
    // 大字标」卡片同一风格）。语言键与 names 同一套 tag，宿主按界面语言挑一张，
    // 缺语言回落 en。zh-Hant 无繁体字标源文件，暂用简中版。
    "logo": {
      "zh-Hans": "assets/launcher/endfield/logo/zh-hans.png",
      "zh-Hant": "assets/launcher/endfield/logo/zh-hant.png",
      "en": "assets/launcher/endfield/logo/en-us.png",
      "ja": "assets/launcher/endfield/logo/ja-jp.png",
      "ko": "assets/launcher/endfield/logo/ko-kr.png"
    },
    "poster": null
  },

  // Per-item images (gacha characters / weapons), files named <id>.png inside this folder.
  "icons": "icons",

  // Web panels rendered by the host WebView. The pack owns html/js/css and the API calls;
  // the host only provides the container, the login state and the script bridge.
  "ui": {
    "community": "ui/community.html",
    // 抽卡页：宿主在「寻访记录」入口挂通用 WebView 容器，页面自己走 provider 的
    // fetch / gacha-stats / gacha-url；统计口径与接口知识全在包内（gacha.py + provider.py）。
    "gacha": "ui/gacha.html"
  },

  // 寻访记录由外部进程提供（protocol 1，见 docs/游戏包-Provider协议-交接.md）。
  // 用 py launcher 而不是 python：后者在装了 Microsoft Store 版时会命中应用执行别名，
  // 直接启动会弹商店而不是跑脚本。py 由官方安装器随附，更稳。
  "provider": {
    "command": "py",
    "args": ["provider.py"],
    "protocol": 1
  },

  // 宿主 UI 文案覆盖：键 = lang:<Lang 属性名>，宿主只认键不认游戏词；缺键回落宿主翻译。
  // gacha.title 是旧版槽位，保留兼容。带 {0} 的键必须保留占位符。
  "strings": {
    // 社区导航项的宿主文案覆盖：键是通用 Lang 属性名，宿主不认识「森空岛」这个词。
    // 包声明了 ui.community 面板，宿主会把这个导航项显示出来并改道到通用 WebView 容器。
    "lang:KuroBbs": "森空岛",
    "gacha.title": "寻访记录",
    "lang:GachaLogPage_ConveneRecords": "寻访记录",
    "lang:GachaLogPage_EmptyTitle": "暂无寻访记录",
    "lang:GachaLogPage_EmptyDesc": "寻访记录由游戏包提供；完成账号授权后，点击「更新记录」即可同步数据。",
    "lang:GachaLogPage_ImportUrl": "导入寻访记录链接",
    "lang:GachaLogPage_ImportUrlDesc": "粘贴寻访记录数据源链接，或从其他工具复制。",
    "lang:GachaLogPage_ImportUrlPlaceholder": "粘贴寻访记录链接",
    "lang:GachaLogPage_UrlInvalid": "链接无效：请粘贴可读取寻访记录的完整链接",
    "lang:GachaLogPage_CopyUrl": "复制寻访记录链接",
    "lang:GachaLogPage_ClearSavedUrlConfirm": "确定删除本地保存的寻访记录链接吗？（已同步的记录不会删除）",
    "lang:GachaLogPage_NoSavedUrl": "没有已保存的寻访记录链接，请先执行一次「更新（全部）」",
    "lang:GachaLogPage_LinkHelp": "寻访记录链接失效？",
    "lang:GachaLogPage_LinkHelpDesc": "重新获取链接后再更新记录",
    "lang:GachaLogPage_LinkExpired": "寻访记录链接已失效",
    "lang:GachaLogPage_LinkExpiredDesc": "链接已失效（接口返回 {0}），请重新获取寻访记录链接",
    "lang:GachaLogPage_FetchEmpty": "未获取到任何寻访记录",
    "lang:GachaLogPage_FetchEmptyDesc": "接口未报错但全部卡池均无记录，请重新获取寻访记录链接后重试",
    "lang:GachaLogPage_UpdateFailed": "更新寻访记录失败：{0}",
    "lang:GachaLogPage_LogNotFound": "未找到寻访记录数据源：请先完成账号授权，或在「更新记录」菜单中选择「粘贴链接导入」",
    "lang:GachaLogPage_UrlNotFound": "未找到寻访记录链接，请重新获取后再试",
    "lang:GachaLogPage_DeleteConfirmText": "即将删除 UID {0} 的所有本地寻访记录，此操作不可恢复。",
    "lang:GachaLogPage_ExportEmpty": "当前账号没有可导出的寻访记录",
    "lang:GachaLogPage_RefetchFromCloudGame": "重新获取寻访记录链接",
    "lang:CloudGame_StatusDefault": "获取寻访记录链接",
    "lang:CloudGame_StatusOk": "获取成功（玩家 {0}），正在同步寻访记录…"
  },

  // 设置页：语义在 settings.cs（C#，settings-provider.exe）里，走 provider 协议 settings-model
  // 返回通用行模型（toggle/choice/number/slider + visibleWhen/enabledWhen/writes），宿主只渲染。
  // 键名/联动/GPU 过滤全部在包代码里，注册表写入由宿主按下方的 store 路径统一执行。
  // 旧 JSON 设置表已删除（表达式能力不够：联动、模式互换、N 卡过滤都写不出来）。
  "settingsProvider": { "command": "settings-provider.exe", "protocol": 1 },

  // Install/update feed. null = the official launcher owns updates.
  "update": null
}
