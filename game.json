{
  // Game pack: everything Arietta needs to show and start Arknights: Endfield.
  // Lives outside the source tree (under <data>/games), so the repo stays game-agnostic.
  // Pack id doubles as the fallback title when the current UI language has no "names" entry.
  "id": "arknights-endfield",

  // Localized titles. No default language: a missing tag shows the id above.
  "names": {
    "zh-Hans": "明日方舟：终末地",
    "zh-Hant": "明日方舟：終末地",
    "en": "Arknights: Endfield",
    "ja": "アークナイツ：エンドフィールド",
    "ko": "명일방주: 엔드필드"
  },

  "vendor": "PaperKito",
  "version": "1.0.1",
  "order": 100,
  "icon": "icon.png",
  // 单服回落值：不认识 servers 的旧宿主仍把它当成国服单服包。
  "serverCode": "CN",

  // 服务器变体：宿主把一份 manifest 展开成多个可切换条目，共用封面 / provider / 设置页，
  // 但各自保存 exe 路径（PackExePath_<变体id>）与切换器选中状态。
  // 顺序对齐鸣潮：全球 → 中国 → Bilibili；CN 标 primary 保留原 id，
  // 已有的 PackExePath_arknights-endfield 配置不会丢。
  // 服短名由包自己声明（names），按终末地官方叫法，不回落到宿主码表的「国际服 / 中国服 / 哔哩哔哩」；
  // 缺语言时宿主回落 en，再缺回落第一个。
  // markerDirs 覆盖只用于自动查找时区分安装目录，实际目录名待按各服客户端实测校正。
  "servers": [
    {
      "code": "GL",
      "id": "global",
      "names": {
        "zh-Hans": "全球",
        "zh-Hant": "全球",
        "en": "Global",
        "ja": "グローバル",
        "ko": "글로벌"
      },
      "markerDirs": [ "Arknights Endfield Global", "Endfield Global" ]
    },
    {
      "code": "CN",
      "primary": true,
      "names": {
        "zh-Hans": "中国",
        "zh-Hant": "中國",
        "en": "China",
        "ja": "中国",
        "ko": "중국"
      }
    },
    {
      "code": "BILI",
      "id": "bilibili",
      "names": {
        "zh-Hans": "Bilibili",
        "zh-Hant": "Bilibili",
        "en": "Bilibili",
        "ja": "Bilibili",
        "ko": "Bilibili"
      },
      "serverIcon": "assets/launcher/endfield/server-bilibili.png",
      "markerDirs": [ "Arknights Endfield bilibili", "Endfield bilibili" ]
    }
  ],

  "exeNames": [ "Endfield.exe" ],
  "markerDirs": [ "Arknights Endfield" ],

  "launch": {
    "exe": "Endfield.exe",
    "args": "",
    // Endfield.exe is requireAdministrator and checks that its immediate parent is a
    // PaperKito-signed Games.exe. PlatformProcess.exe ships next to it, is asInvoker and
    // signed by the same certificate, so it can be staged as the suspended decoy parent.
    "decoyParent": "PlatformProcess.exe",
    "requireAdmin": true
  },

  "capabilities": {
    "launch": true,
    "gacha": true,
    "settings": true,
    "update": false,
    "accounts": false,
    // 原生社区模块（森空岛）：宿主「社区」导航项 → 原生 PackCommunityPage，
    // 模型由 provider 的 community-model 提供（NavigationView + Frame + 通用块渲染）。
    "community": true,
    // Pack provider offers a daily sign-in action (community-action) the host can auto-run.
    "communityAutoSign": true
  },

  // Artwork shipped by the pack (paths relative to the pack folder; source: official
  // GRYPHLINK launcher, see docs/资源-GRYPHLINK启动器封面与壁纸提取-交接.md).
  "assets": {
    // 主页缺省背景：用户没选背景也没拖图时铺这张（2324×1392 主视觉）。
    "background": "assets/launcher/endfield/background.webp",
    // 主题强调色：宿主直接拿它给按钮 / 开关等 Accent 控件上色，不再从背景图投票取色。
    // 这张主视觉白灰底 + 角色蓝灰占面积大，色相投票会算出蓝色（#477AB2）而不是品牌黄。
    "accentColor": "#E6D800",
    // 游戏切换器全屏卡片图：endfield_icons-main 的本地化字标 SVG 栅格化后反色成
    // 白字，合成到黑底 960×540（字标统一占卡宽 84% 居中，与鸣潮/战双「纯黑底
    // 大字标」卡片同一风格）。语言键与 names 同一套 tag，宿主按界面语言挑一张，
    // 缺语言回落 en。zh-Hant 无繁体字标源文件，暂用简中版。
    "logo": {
      "zh-Hans": "assets/launcher/endfield/logo/zh-hans.png",
      "zh-Hant": "assets/launcher/endfield/logo/zh-hant.png",
      "en": "assets/launcher/endfield/logo/en-us.png",
      "ja": "assets/launcher/endfield/logo/ja-jp.png",
      "ko": "assets/launcher/endfield/logo/ko-kr.png"
    },
    "poster": null
  },

  // Per-item images (gacha characters / weapons), files named <id>.png inside this folder.
  "icons": "icons",

  // 云同步声明：数据目录里哪些文件搭宿主 WebDAV 同步的车（通配只支持 *，平目录）。
  // gacha-*.json 是按凭证指纹一账号一份的寻访缓存（provider.py cache_key）——链接过期后
  // 本地就是唯一副本，值得跨设备。community.json 由宿主拆成按账号对象自行同步，不用声明；
  // wiki 图标等可再生缓存不声明 = 永远只留在本机。
  "sync": ["gacha-*.json"],

  // Web panels rendered by the host WebView. The pack owns html/js/css and the API calls;
  // the host only provides the container, the login state and the script bridge.
  // （community 曾是本地 WebView 面板，已按原生 WinUI3 方案作废删除，
  //   见 docs/森空岛模块-原生WinUI3方案-归档.md；实现交接文档在宿主仓库 docs/。）
  // 抽卡页已改走宿主原生 WinUI3 页（PackGachaPage + provider 的 gacha-model），
  // 不再由包声明 WebView 面板；ui 留空供后续面板使用。
  "ui": {},

  // 寻访记录由外部进程提供（protocol 1，见 docs/游戏包-Provider协议-交接.md）。
  // 用 py launcher 而不是 python：后者在装了 Microsoft Store 版时会命中应用执行别名，
  // 直接启动会弹商店而不是跑脚本。py 由官方安装器随附，更稳。
  "provider": {
    "command": "py",
    "args": ["provider.py"],
    "protocol": 1
  },

  // 宿主 UI 文案覆盖：键 = lang:<Lang 属性名>.<语言tag>，宿主查 tag → 裸键 → 宿主翻译。
  // 2026-11-17 起全部带语言后缀（裸键全语言生效，会把宿主已翻的 en/ja/… 打回中文）。
  // zh-Hans / zh-Hant / en / ja / ko 由包提供（en/ja/ko 用官方术语 Headhunting，见
  // endfield.wiki.gg；繁体为本包繁化）；fr/de/es/th/pt-BR 不写覆盖 = 回落宿主通用译文。
  // 带占位符 {0} 的键必须保留占位符。
  "strings": {
    // 社区导航项的宿主文案覆盖：键是通用 Lang 属性名，宿主不认识「森空岛」这个词
    //（宿主通用表在这键上是鸣潮的「库街区 / Kuro BBS」，对终末地是错的，所以 10 语全包）。
    "lang:KuroBbs.zh-Hans": "森空岛",
    "lang:KuroBbs.zh-Hant": "森空島",
    "lang:KuroBbs.en": "Skland",
    "lang:KuroBbs.ja": "スカランド",
    "lang:KuroBbs.ko": "스칸드",
    "lang:KuroBbs.fr": "Skland",
    "lang:KuroBbs.de": "Skland",
    "lang:KuroBbs.es": "Skland",
    "lang:KuroBbs.th": "Skland",
    "lang:KuroBbs.pt-BR": "Skland",

    // gacha.title 是旧版槽位（宿主 LegacyPackSlots 回退用），保留兼容，值随 ConveneRecords。
    "gacha.title.zh-Hans": "寻访记录",
    "gacha.title.zh-Hant": "尋訪記錄",
    "gacha.title.en": "Headhunting Records",
    "gacha.title.ja": "ヘッドハンティング記録",
    "gacha.title.ko": "헤드헌팅 기록",

